// Shared build settings for the Notes app (iPad + Mac Catalyst).
// All settings live in xcconfig files so the .xcodeproj rarely changes.

SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
IPHONEOS_DEPLOYMENT_TARGET = 26.0

// iPad-only app that also runs on the Mac via Catalyst.
TARGETED_DEVICE_FAMILY = 2
SUPPORTS_MACCATALYST = YES
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
// Keep ONE bundle id across iPad and Mac so a single App ID / iCloud
// container serves both (a derived maccatalyst.* id would need its own).
DERIVE_MACCATALYST_PRODUCT_BUNDLE_IDENTIFIER = NO

PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = com.linuskuehne.notes
MARKETING_VERSION = 1.0
// NOTE: NSUbiquitousContainers changes in Info.plist are only re-read by
// iCloud when CFBundleVersion increases — bump this when touching them.
CURRENT_PROJECT_VERSION = 1

// Xcode 26 new-project defaults: Swift 6 language mode with approachable
// concurrency; app code is MainActor by default (right for a UIKit/SwiftUI
// app — NotesCore has its own settings).
SWIFT_VERSION = 6.0
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_EMIT_LOC_STRINGS = YES

GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = NotesApp/Info.plist
CODE_SIGN_ENTITLEMENTS = NotesApp/NotesApp.entitlements
CODE_SIGN_STYLE = Automatic

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES

ENABLE_USER_SCRIPT_SANDBOXING = YES
CLANG_ENABLE_MODULES = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
